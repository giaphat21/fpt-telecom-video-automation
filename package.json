{
  "name": "fpt-telecom-video-automation",
  "version": "1.7.0",
  "private": true,
  "description": "FPT Telecom speech-synchronized video automation studio",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "node src/server.js",
    "doctor": "node scripts/build/validate_project.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:ui": "node tests/e2e/run_studio_smoke.js",
    "test:broll": "node tests/e2e/render_speech_broll_smoke.js",
    "generate:broll-cards": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/assets/generate_broll_cards.ps1",
    "capcut:list": "node scripts/tools/capcut_bridge.js --list",
    "verify": "npm run doctor && npm test && node tests/e2e/render_broll_smoke.js && npm run test:broll && npm run test:ui",
    "generate:product-broll": "node scripts/assets/generate_product_broll.js",
    "docs:typography": "node scripts/build/typography_catalog.js",
    "package": "node scripts/build/package_release.js",
    "test:timeline": "node tests/e2e/run_studio_smoke.js timeline"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.2.0",
    "capcut-cli": "0.34.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  }
}
